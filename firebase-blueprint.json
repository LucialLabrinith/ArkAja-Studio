{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents an authenticated ArkAja Studio client user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique Firebase Auth user ID." },
        "email": { "type": "string", "format": "email", "description": "User email address." },
        "displayName": { "type": "string", "description": "Client full name or display name." },
        "photoURL": { "type": "string", "description": "Profile photo URL." },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation." },
        "lastLoginAt": { "type": "string", "description": "ISO timestamp of most recent login." }
      },
      "required": ["uid", "email"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Client project enquiry or commission brief submitted to ArkAja Studio.",
      "type": "object",
      "properties": {
        "enquiryId": { "type": "string", "description": "Unique reference ID for the enquiry." },
        "userId": { "type": "string", "description": "Owner user ID if submitted by signed in client, or guest." },
        "userEmail": { "type": "string", "description": "Email address of the client." },
        "fullName": { "type": "string", "description": "Full name of the contact person." },
        "brandName": { "type": "string", "description": "Brand or business name." },
        "email": { "type": "string", "format": "email", "description": "Contact email." },
        "country": { "type": "string", "description": "Client operating country." },
        "phone": { "type": "string", "description": "Phone or WhatsApp contact." },
        "businessCategory": { "type": "string", "description": "Industry or niche." },
        "neededServices": { "type": "array", "description": "List of selected creative services." },
        "preferredPackage": { "type": "string", "description": "Starter, Signature, or Custom." },
        "timeline": { "type": "string", "description": "Project launch timeline." },
        "budget": { "type": "string", "description": "Target investment budget range." },
        "projectDetails": { "type": "string", "description": "Comprehensive brief details." },
        "status": { "type": "string", "description": "Review status: pending, reviewed, accepted." },
        "createdAt": { "type": "string", "description": "ISO timestamp of submission." }
      },
      "required": ["enquiryId", "fullName", "brandName", "email", "projectDetails", "createdAt"]
    },
    "ProjectDraft": {
      "title": "ProjectDraft",
      "description": "Saved project scope draft created with the custom builder.",
      "type": "object",
      "properties": {
        "draftId": { "type": "string", "description": "Unique draft identifier." },
        "userId": { "type": "string", "description": "Owner Firebase UID." },
        "brandName": { "type": "string", "description": "Client brand name draft." },
        "category": { "type": "string", "description": "Primary brand category." },
        "timeline": { "type": "string", "description": "Draft timeline." },
        "budget": { "type": "string", "description": "Draft budget." },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update." }
      },
      "required": ["draftId", "userId", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio creative project published by studio owner divyaam2008@gmail.com.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique project identifier or slug." },
        "title": { "type": "string", "description": "Title of the project or collection." },
        "client": { "type": "string", "description": "Brand or client name." },
        "category": { "type": "string", "description": "Portfolio category discipline." },
        "subtitle": { "type": "string", "description": "Short creative tagline or concept." },
        "description": { "type": "string", "description": "Detailed art direction narrative." },
        "thumbnail": { "type": "string", "description": "Primary hero image asset URL or base64." },
        "deliverables": { "type": "array", "description": "List of deliverables included in project." },
        "tags": { "type": "array", "description": "Taxonomy tags." },
        "createdAt": { "type": "string", "description": "ISO timestamp of publication." },
        "createdBy": { "type": "string", "description": "Admin email who created the project." }
      },
      "required": ["id", "title", "category", "thumbnail", "createdAt"]
    },
    "StudioInfo": {
      "title": "ArkAja Studio",
      "description": "Studio branding, identity and database registration for ArkAja Studio.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "ArkAja Studio" },
        "studioName": { "type": "string", "description": "ArkAja Studio" },
        "email": { "type": "string", "format": "email", "description": "arkajastudio@gmail.com" },
        "tagline": { "type": "string", "description": "Creative content for brands with something to say." },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update." }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document keyed by Firebase Auth UID."
    },
    "/enquiries/{enquiryId}": {
      "schema": "Enquiry",
      "description": "Client enquiries collection submitted to the studio."
    },
    "/users/{userId}/drafts/{draftId}": {
      "schema": "ProjectDraft",
      "description": "Client saved project scope drafts."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Public portfolio showcase projects created by studio owner."
    },
    "/studio/{studioId}": {
      "schema": "StudioInfo",
      "description": "ArkAja Studio official metadata and brand information."
    }
  }
}
